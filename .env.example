# Origem pública do site (canonical, sitemap, Open Graph). Na Vercel, se omitida,
# usa VERCEL_PROJECT_PRODUCTION_URL e depois VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token do GitHub (somente servidor; nunca NEXT_PUBLIC_). Sem ele, o site usa o fallback estático.
GITHUB_TOKEN=

# URL do Postgres (Neon) com a role `site`, somente servidor; nunca NEXT_PUBLIC_. Sem ela, o site usa o conteúdo estático.
DATABASE_URL=

# Segredo da rota POST /api/revalidar (somente servidor). Use o mesmo valor em painel/.env.
REVALIDATE_SECRET=

# Segredo (mínimo de 32 caracteres aleatórios, somente servidor) que serve de base
# do sal diário usado para anonimizar visitantes na coleta. Nunca NEXT_PUBLIC_.
COLETA_SEGREDO=
