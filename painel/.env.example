# Copie para .env (ignorado pelo git) e preencha.
# URL JDBC do Neon, no formato jdbc:postgresql://<host>/<db>?sslmode=require
PAINEL_DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
PAINEL_DATABASE_USER=
PAINEL_DATABASE_PASSWORD=
# URL publica do site (para pedir revalidacao do cache)
SITE_URL=https://seu-site.example
# Mesmo valor de REVALIDATE_SECRET configurado no site
REVALIDATE_SECRET=
